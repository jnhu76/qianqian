{
  "profile": "c3-wav",
  "ladder": "C3",
  "extends": "c2-alac",
  "description": "C2 + PCM WAV: RIFF/WAVE container with the six real-world PCM sample representations (u8, s16le, s24le, s32le, f32le, f64le). SongCore output stays Float32 interleaved at source rate/layout; no resampler is introduced. Baseline dimensions --disable-iconv/--disable-pthreads (E07-accepted) are composed in.",
  "component_base": "everything-disabled",
  "libraries": {
    "enable": [
      "avformat",
      "avcodec"
    ],
    "disable": [
      "swresample",
      "avdevice",
      "avfilter",
      "swscale"
    ]
  },
  "disable": [
    "autodetect",
    "debug",
    "devices",
    "doc",
    "iconv",
    "network",
    "programs",
    "protocols",
    "pthreads",
    "x86asm"
  ],
  "components": {
    "demuxer": [
      "aac",
      "flac",
      "mov",
      "mp3",
      "wav"
    ],
    "decoder": [
      "aac",
      "alac",
      "flac",
      "mp3float",
      "pcm_u8",
      "pcm_s16le",
      "pcm_s24le",
      "pcm_s32le",
      "pcm_f32le",
      "pcm_f64le"
    ],
    "parser": [
      "mpegaudio"
    ]
  },
  "provenance": {
    "demuxer:wav": {
      "required_by": [
        "wav-*"
      ],
      "reason": "issue #8 capability intent: WAV container -> PCM decoders"
    },
    "decoder:pcm_u8": {
      "required_by": [
        "wav-u8-44-mono"
      ],
      "reason": "one fixture per PCM sample representation is mandatory"
    },
    "decoder:pcm_s16le": {
      "required_by": [
        "wav-s16le-44-stereo",
        "wav-odd-chunk",
        "wav-truncated"
      ],
      "reason": "most common WAV representation"
    },
    "decoder:pcm_s24le": {
      "required_by": [
        "wav-s24le-96-stereo"
      ],
      "reason": "24-bit studio WAV; decodes into s32 samples"
    },
    "decoder:pcm_s32le": {
      "required_by": [
        "wav-s32le-48-stereo"
      ],
      "reason": "32-bit integer WAV"
    },
    "decoder:pcm_f32le": {
      "required_by": [
        "wav-f32le-44-stereo"
      ],
      "reason": "32-bit float WAV"
    },
    "decoder:pcm_f64le": {
      "required_by": [
        "wav-f64le-44-mono"
      ],
      "reason": "64-bit float WAV"
    }
  }
}
