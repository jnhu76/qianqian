#!/usr/bin/env python3
"""Component necessity probe: the deletion experiment behind N3 provenance.

For every enabled component in the n3-min profile, build a variant of N3
with exactly that component removed and run the full Stage A corpus
correctness flow against it.

  variant fails  -> the component is REQUIRED by the failing corpus cases
                    (recorded as required_by, with probe evidence)
  variant passes -> the component is NOT justified: it must be dropped
                    from n3-min (the probe exits nonzero to force this)

lib:swresample necessity is probed separately by the n3-min-noswr profile
(bypass experiment) rather than a removal probe, because removing it
changes the SongCore output contract, not FFmpeg decoding.

Usage: scripts/probe-necessity [profile=n3-min]
Writes: bench/provenance/component-provenance.json
        bench/provenance/enabled-components.<profile>.txt   (copied from build)
        bench/provenance/configure-args.<profile>.txt
"""
import importlib.util
import json
import os
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def load_mod(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


bp = load_mod(os.path.join(ROOT, "scripts", "build-profile"), "bp")
rb = load_mod(os.path.join(ROOT, "bench", "harness", "run_bench.py"), "rb")


def correctness_for(profile_name, manifest, timeout=120):
    """Run the correctness flow for every corpus case with one bench binary."""
    exe = os.path.join(ROOT, "build", profile_name, "qn_bench")
    out = {}
    for case in manifest["cases"]:
        fixture = os.path.join(ROOT, "corpus", "fixtures", case["file"])
        obs = rb.run_bench_binary(exe, "correct", fixture, timeout=timeout)
        status, checks = rb.check_case(case, obs, [])
        out[case["id"]] = status
    return out


def main():
    profile_name = sys.argv[1] if len(sys.argv) > 1 else "n3-min"
    profile = json.load(open(os.path.join(ROOT, "bench", "profiles", f"{profile_name}.json")))
    manifest = json.load(open(os.path.join(ROOT, "corpus", "manifest", "stage-a.json")))

    baseline = correctness_for(profile_name, manifest)
    print(f"baseline {profile_name}: {sum(1 for s in baseline.values() if s == 'pass')}"
          f"/{len(baseline)} pass")

    probes = []
    components = profile.get("components", {})
    for cls in ("demuxer", "decoder", "parser", "bsf", "protocol", "filter"):
        names = components.get(cls)
        if not names or names == "audio-only":
            continue
        for name in names:
            variant = json.loads(json.dumps(profile))
            variant["components"] = {k: (v if k != cls else [n for n in v if n != name])
                                     for k, v in variant["components"].items()}
            variant["profile"] = f"{profile_name}-probe-no-{cls}-{name}"
            variant["probe_of"] = profile_name
            variant.pop("provenance", None)

            probe_dir = os.path.join(ROOT, "build", "probes")
            os.makedirs(probe_dir, exist_ok=True)
            pf = os.path.join(probe_dir, variant["profile"] + ".json")
            with open(pf, "w") as f:
                json.dump(variant, f, indent=2)

            print(f"--- probing: removing {cls}:{name} ---")
            subprocess.run([os.path.join(ROOT, "scripts", "build-profile"),
                            "--profile-file", pf], cwd=ROOT, check=True)
            res = correctness_for(variant["profile"], manifest)
            failed = sorted(cid for cid, s in res.items() if s == "fail")
            ok = sum(1 for s in res.values() if s in ("pass", "degraded_pass"))
            print(f"    {ok}/{len(res)} pass; failing without {cls}:{name}: {failed}")
            probes.append({
                "component": f"{cls}:{name}",
                "variant_profile": variant["profile"],
                "corpus_cases_failed_without_it": failed,
                "corpus_cases_passed_without_it": ok,
                "required": bool(failed),
                "evidence": "removal-probe" if failed else "NONE — component is not justified",
            })

    baseline_components = os.path.join(ROOT, "build", profile_name, "meta",
                                       "enabled-components.txt")
    provenance = {
        "profile": profile_name,
        "method": "one-component removal probes over the full Stage A corpus; "
                  "a component stays only if its removal fails corpus cases. "
                  "lib:swresample is probed by the n3-min-noswr bypass profile.",
        "baseline_correctness": baseline,
        "probes": probes,
        "libraries": {
            "lib:swresample": {
                "probe": "n3-min vs n3-min-noswr bypass profiles (see bench/results "
                         "summary swr_bypass_pcm_identical and the size delta)",
            },
        },
        "internal_modules_note": "id3v2/apetag/replaygain/flac picture handling are "
                                 "internal libavformat modules of the mp3/flac demuxers, "
                                 "not individually selectable components.",
    }
    out_dir = os.path.join(ROOT, "bench", "provenance")
    os.makedirs(out_dir, exist_ok=True)
    with open(os.path.join(out_dir, "component-provenance.json"), "w") as f:
        json.dump(provenance, f, indent=2, ensure_ascii=False)
        f.write("\n")
    if os.path.exists(baseline_components):
        shutil.copyfile(baseline_components,
                        os.path.join(out_dir, f"enabled-components.{profile_name}.txt"))
    args_f = os.path.join(ROOT, "build", profile_name, "configure-args.txt")
    if os.path.exists(args_f):
        shutil.copyfile(args_f,
                        os.path.join(out_dir, f"configure-args.{profile_name}.txt"))

    unjustified = [p["component"] for p in probes if not p["required"]]
    if unjustified:
        print(f"\nNOT JUSTIFIED (must be removed from {profile_name}): {unjustified}")
        sys.exit(1)
    print(f"\nall probes passed: every remaining component has corpus evidence")


if __name__ == "__main__":
    main()
