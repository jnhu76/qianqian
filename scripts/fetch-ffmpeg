#!/usr/bin/env bash
# Fetch and verify the pinned FFmpeg source tree.
#
# Usage: scripts/fetch-ffmpeg [--force]
#
# Result: build/ffmpeg-src/  (untracked) + build/downloads/ffmpeg-<tag>.zip cache
#
# The source tree is NOT committed to the repo. Integrity comes from:
#   1. zip sha256 recorded in bench/ffmpeg-pin.json
#   2. tag -> commit sha recorded in bench/ffmpeg-pin.json
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PIN="$ROOT/bench/ffmpeg-pin.json"
BUILD="$ROOT/build"
DOWNLOADS="$BUILD/downloads"
SRC="$BUILD/ffmpeg-src"
FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

TAG=$(python3 -c "import json;print(json.load(open('$PIN'))['ffmpeg_tag'])")
URL=$(python3 -c "import json;print(json.load(open('$PIN'))['source_url'])")
EXPECT_SHA=$(python3 -c "import json;print(json.load(open('$PIN'))['source_sha256'])")
EXPECT_COMMIT=$(python3 -c "import json;print(json.load(open('$PIN'))['ffmpeg_commit_sha'])")
ZIP="$DOWNLOADS/ffmpeg-$TAG.zip"

mkdir -p "$DOWNLOADS"

# Re-verify the pinned tag still points at the pinned commit when network allows.
export QIANQIAN_FETCH_PROXY="${QIANQIAN_FETCH_PROXY:-${https_proxy:-http://127.0.0.1:7897}}"
proxy_env="https_proxy=$QIANQIAN_FETCH_PROXY http_proxy=$QIANQIAN_FETCH_PROXY"
if remote_commit=$(eval "$proxy_env git ls-remote https://github.com/FFmpeg/FFmpeg 'refs/tags/$TAG^{}'" 2>/dev/null | awk '{print $1}') && [[ -n "$remote_commit" ]]; then
  if [[ "$remote_commit" != "$EXPECT_COMMIT" ]]; then
    echo "FATAL: upstream tag $TAG now points to $remote_commit, pin says $EXPECT_COMMIT" >&2
    exit 1
  fi
  echo "tag recheck ok: $TAG -> $remote_commit"
else
  echo "warning: could not reach github for tag recheck; relying on zip sha256" >&2
fi

if [[ $FORCE -eq 0 && -f "$SRC/.qianqian-verified" ]]; then
  verified=$(cat "$SRC/.qianqian-verified")
  if [[ "$verified" == "$EXPECT_COMMIT|$EXPECT_SHA" ]]; then
    echo "ffmpeg source already fetched and verified: $SRC"
    exit 0
  fi
  echo "pin changed; re-fetching" >&2
fi

if [[ ! -f "$ZIP" ]]; then
  echo "downloading $URL"
  eval "$proxy_env curl -sL --max-time 600 -o '$ZIP' '$URL'"
fi

actual_sha=$(sha256sum "$ZIP" | awk '{print $1}')
if [[ "$actual_sha" != "$EXPECT_SHA" ]]; then
  echo "FATAL: sha256 mismatch for $ZIP" >&2
  echo "  expected: $EXPECT_SHA" >&2
  echo "  actual:   $actual_sha" >&2
  exit 1
fi
echo "zip sha256 ok: $actual_sha"

rm -rf "$SRC" "$BUILD/ffmpeg-extract"
mkdir -p "$BUILD/ffmpeg-extract"
unzip -q "$ZIP" -d "$BUILD/ffmpeg-extract"
extracted_dir=$(find "$BUILD/ffmpeg-extract" -mindepth 1 -maxdepth 1 -type d | head -1)
mv "$extracted_dir" "$SRC"
rmdir "$BUILD/ffmpeg-extract"

version=$(cat "$SRC/RELEASE" 2>/dev/null || echo unknown)
echo "extracted ffmpeg $version at $SRC"
printf '%s|%s\n' "$EXPECT_COMMIT" "$EXPECT_SHA" > "$SRC/.qianqian-verified"
