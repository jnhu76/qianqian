#!/usr/bin/env bash
# End-to-end Phase 0 Step 1 native benchmark:
#   fetch pinned FFmpeg -> build every profile -> run corpus harness.
#
# Usage:
#   scripts/bench-native                 # everything (reuses build caches)
#   OUT=DIR scripts/bench-native         # where to write results
#                                          (default bench/results/runs/<ts>)
#   scripts/bench-native --force         # rebuild FFmpeg even if cached
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

OUT="${OUT:-bench/results/runs/$(date +%Y%m%dT%H%M%S)}"
ARGS=""
for a in "$@"; do
  case "$a" in
    --force) ARGS="$ARGS --force" ;;
  esac
done

scripts/fetch-ffmpeg

for p in n0-full n1-audio n2-stage-a n3-min n3-min-noswr; do
  scripts/build-profile "$p" $ARGS
done

python3 bench/harness/run_bench.py --out "$OUT"
echo "results: $OUT"
