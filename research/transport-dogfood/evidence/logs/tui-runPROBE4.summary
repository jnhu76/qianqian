C9-resize: GREEN (1795ms, exit Some(0))
    expect "Format: 44100 Hz" OK
    resize 80x24
    keys " "
    expect "Pause requested: true" OK
    keys " "
    expect "Pause requested: false" OK
    resize 120x40
    keys "x"
    expect "Volume: 100/100 (desired)" OK
    absent-after-mark "teardown violated" OK
    keys "q"
    exit 0 OK
