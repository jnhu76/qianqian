flowchart TB
    subgraph K0["Base Kernel K0 Boundary"]
        direction TB

        C["Context\nreachability / dependency view"]
        CAP["Capability\nnamed service contract"]
        F["Fiber\nlive plugin instance"]
        E["Effect\nowned reversible mutation"]
        R["Reconcile\nmove graph toward desired"]

        C ---|"resolves"| CAP
        F ---|"owns"| E
        R -->|"desired composition"| F
    end

    subgraph Excluded["Excluded from K0"]
        direction TB
        X1["Track"]
        X2["PCM"]
        X3["PlaybackState"]
        X4["Position"]
        X5["Device Policy"]
    end

    Desired["Desired\nComposition"] -->|"input"| R
    R -->|"output"| Running["Running\nFiber Graph"]

    Desired -.->|"not in K0"| Excluded

    style K0 fill:#1a1a2e,stroke:#4a4a6a,color:#e0e0e0
    style Excluded fill:#2a1a1a,stroke:#6a3a3a,color:#e0a0a0

    classDef primitive fill:#2d6a4f,stroke:#4a9a6f,color:#e0e0e0
    classDef excluded fill:#3a2a2a,stroke:#6a4a4a,color:#c0a0a0

    class C,CAP,F,E,R primitive
    class X1,X2,X3,X4,X5 excluded
