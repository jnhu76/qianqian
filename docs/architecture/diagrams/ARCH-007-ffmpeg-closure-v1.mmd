        direction TB
        CI["Capability Intent\ndecode encoded media"]
        CF["Configure / Import Oracle\nFFmpeg build profiles"]
        MC["Machine-Derived Closure\none FFmpeg closure authority"]
        MF["Manifest\ncodec-base, songcore-test profiles"]
        XR["Xmake Replay\nreproducible build"]
        SP["Shipping / Product Probe\nbinary size, symbol audit"]

        CI --> CF
        CF --> MC
        MC --> MF
        MF --> XR
        XR --> SP
