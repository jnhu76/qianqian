        DEC["Decoder\nencoded media → PCM"]
        PROC["Processing\nPCM → PCM"]

        DEC ---|"shares one\nFFmpeg closure"| PROC
    end

    MC -.->|"authority"| Components

    style FFMPEG fill:#1a1a2e,stroke:#4a4a6a,color:#e0e0e0
