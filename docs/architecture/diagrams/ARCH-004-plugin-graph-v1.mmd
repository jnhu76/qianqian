flowchart LR
    subgraph Current["Current Intended Shape"]
        DEC["Decoder\n(encoded media → PCM)"]
        MUSIC["Music / Playback\n(domain semantics)"]
        AOUT["AudioOutput\n(PCM → physical)"]

        DEC -->|"provides Decoder capability"| MUSIC
        MUSIC -->|"requires Decoder"| DEC
        MUSIC -->|"binds PcmSink"| AOUT
        AOUT -->|"provides PcmSink"| MUSIC
    end

    subgraph Future["Future Components"]
        PROC["Processing\n(PCM → PCM)"]
        UH["UiHost\n(presentation)"]
    end

    MUSIC -.->|"future: PCM → PCM"| PROC
    PROC -.->|"future: PCM → physical"| AOUT
    MUSIC -.->|"future: poll snapshot"| UH

    style Current fill:#1a1a2e,stroke:#4a4a6a,color:#e0e0e0
    style Future fill:#2a2a2a,stroke:#5a5a5a,color:#a0a0a0

    classDef current fill:#4a4a6a,stroke:#6a6a8a,color:#e0e0e0
    classDef future fill:#3a3a3a,stroke:#5a5a5a,color:#a0a0a0

    class DEC,MUSIC,AOUT current
    class PROC,UH future
